# ==============================================================================
# SECURE MULTI-PROVIDER LLM GATEWAY - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Core Service (Layer 1)
APP_NAME="Secure Multi-Provider LLM Gateway"
APP_ENV="development"
DEBUG=false
HOST="127.0.0.1"
PORT=8000

# Client Authentication & Rate Limiting (Layer 1)
# Comma-separated list of valid client API keys
GATEWAY_API_KEYS="gw-test-key-1,gw-test-key-2"
# Rate limit per client per minute
RATE_LIMIT_PER_MINUTE=60

# Local LLM Deployment - Ollama (Layer 2)
# Configured for 8GB RAM machine constraint (qwen2.5:1.5b)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5:1.5b"
OLLAMA_FALLBACK_MODEL="gemma2:2b"
OLLAMA_REQUEST_TIMEOUT=60.0

# Cloud Provider - Groq Free-Tier API (Layer 3)
# NOTE: Free-tier key only (https://console.groq.com/keys) - NO BILLING REQUIRED!
# If left unset, the gateway automatically falls back to local Ollama or mock provider.
GROQ_API_KEY="gsk_your_free_tier_key_here"
GROQ_DEFAULT_MODEL="llama-3.1-8b-instant"

# Multi-Provider Routing & Observability (Layer 3)
# Options: "ollama", "groq", "mock"
DEFAULT_PROVIDER="mock"
ENABLE_STRUCTURED_LOGGING=true
LOG_LEVEL="INFO"
REDACT_SECRETS_IN_LOGS=true
